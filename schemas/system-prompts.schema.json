{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "opencode-sysprompt-override config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "lenient": {
      "type": "boolean",
      "default": false,
      "description": "If true, errors warn-and-skip silently instead of injecting a visible policy-error block into the system prompt. Logs are always written."
    },
    "dynamicBoundaryMarker": {
      "type": "string",
      "description": "Primary marker string that separates the static prompt from opencode's runtime-generated dynamic sections. Default: '\\nYou are powered by the model named'."
    },
    "dynamicFallbackMarker": {
      "type": "string",
      "description": "Fallback marker used when the primary marker is absent. Default: '\\n<env>'."
    },
    "default": {
      "$ref": "#/definitions/RuleBody",
      "description": "Rule applied when no explicit rule matched. No `match` field."
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/definitions/Rule" }
    }
  },
  "definitions": {
    "MatchSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerID": { "type": "string" },
        "providerIDGlob": { "type": "string" },
        "modelID": { "type": "string" },
        "modelIDGlob": { "type": "string" }
      }
    },
    "RuleBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["append", "replace"] },
        "position": { "type": "string", "enum": ["start", "end"], "default": "end" },
        "preserveDynamic": {
          "type": "boolean",
          "default": false,
          "description": "When true and mode is 'replace', keeps opencode's runtime-generated dynamic sections (env, instructions, skills) by splicing only the static portion of the prompt."
        },
        "prompt": { "type": "string" },
        "promptFile": { "type": "string" }
      },
      "oneOf": [
        { "required": ["prompt"], "not": { "required": ["promptFile"] } },
        { "required": ["promptFile"], "not": { "required": ["prompt"] } }
      ]
    },
    "Rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "match": { "$ref": "#/definitions/MatchSpec" },
        "mode": { "type": "string", "enum": ["append", "replace"] },
        "position": { "type": "string", "enum": ["start", "end"], "default": "end" },
        "preserveDynamic": {
          "type": "boolean",
          "default": false,
          "description": "When true and mode is 'replace', keeps opencode's runtime-generated dynamic sections (env, instructions, skills) by splicing only the static portion of the prompt."
        },
        "prompt": { "type": "string" },
        "promptFile": { "type": "string" }
      },
      "oneOf": [
        { "required": ["prompt"], "not": { "required": ["promptFile"] } },
        { "required": ["promptFile"], "not": { "required": ["prompt"] } }
      ]
    }
  }
}
